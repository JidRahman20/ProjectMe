// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@map("users")
}

model Order {
  id                 String   @id @default(cuid())
  code               String   @unique
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  items              Json
  totalAmount        Float
  status             String   @default("pending")
  approvalStatus     String   @default("pending") // pending, approved, rejected - untuk Approval role
  adminStatus        String   @default("pending") // pending, approved, rejected - untuk Admin role
  vendorStatus       String   @default("pending") // pending, accepted, processing, shipped, completed, rejected - untuk Vendor/Pendor
  kegiatan           String?
  tamu               String?
  jumlahTamu         Int?
  bagian             String?
  pengaju            String?
  tanggalPengajuan   String?
  tanggalPengiriman  String?
  approval           String?
  lokasi             String?
  waktu              String?
  keterangan         String?
  rejectionReason    String?
  approvalRejectionReason    String?
  adminRejectionReason       String?
  vendorRejectionReason      String?
  approvedByApproval String?
  approvedByAdmin    String?
  processedByVendor  String?
  approvalDate       DateTime?
  adminApprovalDate  DateTime?
  vendorAcceptedDate DateTime?
  vendorCompletedDate DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("orders")
}
